# ====================================================================
# PaperGrade AI - Environment Configuration (.env.example)
# ====================================================================

# --------------------------------------------------------------------
# 1. Google Gemini API Keys (Multi-Key Rotation & 500 RPD Fallback)
# --------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key-1"
GEMINI_API_KEY_2="your-gemini-api-key-2"
GEMINI_API_KEY_3="your-gemini-api-key-3"
GEMINI_API_KEY_4="your-gemini-api-key-4"
GEMINI_MODEL=gemini-3.8-flash

# --------------------------------------------------------------------
# 2. Database Connection
# Leave empty for local SQLite (./data/papergrade.db).
# Provide Supabase PostgreSQL URI for production pilot:
# --------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# --------------------------------------------------------------------
# 3. Cloudflare R2 / S3 Object Storage (Zero Egress PDF Storage)
# Leave STORAGE_BACKEND=local for local disk storage (./data/uploads).
# Set STORAGE_BACKEND=r2 for Cloudflare R2 storage in production:
# --------------------------------------------------------------------
STORAGE_BACKEND=local
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="papergrade-pilot-bucket"
R2_PUBLIC_URL="" # Optional custom domain, e.g. https://cdn.papergrade.ai

# --------------------------------------------------------------------
# 4. Authentication & Security (JWT)
# --------------------------------------------------------------------
JWT_SECRET="pg_production_secure_jwt_secret_change_me_before_deploying"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Default Seeded Root Admin (created automatically on first launch)
DEFAULT_ADMIN_EMAIL=admin@papergrade.ai
DEFAULT_ADMIN_PASSWORD=AdminPassword123!

# --------------------------------------------------------------------
# 5. Examination Lifecycle Constraints
# --------------------------------------------------------------------
WINDOW_DURATION_MINUTES=30
GRACE_PERIOD_MINUTES=2
MAX_UPLOAD_SIZE_MB=15
MAX_PAGE_COUNT=10
REVALUATION_WINDOW_DAYS=7

# --------------------------------------------------------------------
# 6. AI Studio Quota Settings (Used for Feasibility Calculations)
# --------------------------------------------------------------------
USER_RPM_LIMIT=15
USER_TPM_LIMIT=1000000
USER_RPD_LIMIT=1500

# --------------------------------------------------------------------
# 7. Host & Port Configuration
# --------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
DEBUG=true
NEXT_PUBLIC_API_URL=http://localhost:8000
