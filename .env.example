# ====================================================================
# PaperGrade AI - Environment Configuration (.env.example)
# ====================================================================

# --------------------------------------------------------------------
# 1. Google Gemini API Keys (Multi-Key Rotation & 500 RPD Fallback)
# --------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key-1"
GEMINI_API_KEY_2="your-gemini-api-key-2"
GEMINI_API_KEY_3="your-gemini-api-key-3"
GEMINI_API_KEY_4="your-gemini-api-key-4"
GEMINI_MODEL=gemini-3.8-flash

# --------------------------------------------------------------------
# 2. Database Connection
# Leave empty for local SQLite (backend/data/papergrade.db).
# Provide Supabase PostgreSQL Transaction Pooler URI (:6543) for production:
# --------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
ENVIRONMENT=production
DB_POOL_TYPE=queue
DB_POOL_SIZE=20
DB_POOL_MAX_OVERFLOW=20
FRONTEND_URL=https://papergrade-ai.vercel.app

# --------------------------------------------------------------------
# 3. Cloudflare R2 / S3 Object Storage (Zero Egress PDF Storage)
# Leave STORAGE_BACKEND=local for local disk storage (./data/uploads).
# Set STORAGE_BACKEND=r2 for Cloudflare R2 storage in production:
# --------------------------------------------------------------------
STORAGE_BACKEND=local
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="papergrade-pilot-bucket"
R2_PUBLIC_URL="" # Optional custom domain, e.g. https://cdn.papergrade.ai

# --------------------------------------------------------------------
# 3b. Cloudinary Storage (Zero-Billing Alternative)
# --------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_URL="cloudinary://your-api-key:your-api-secret@your-cloud-name"

# --------------------------------------------------------------------
# 3c. Supabase API Configuration
# --------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# --------------------------------------------------------------------
# 3d. Web Push Notifications (VAPID Keys)
# --------------------------------------------------------------------
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_CLAIMS_EMAIL="mailto:notifications@papergrade.ai"

# --------------------------------------------------------------------
# 4. Authentication & Security (JWT)
# --------------------------------------------------------------------
JWT_SECRET="pg_production_secure_jwt_secret_change_me_before_deploying"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Default Seeded Root Admin (created automatically on first launch)
DEFAULT_ADMIN_EMAIL=admin@papergrade.ai
DEFAULT_ADMIN_PASSWORD=AdminPassword123!

# --------------------------------------------------------------------
# 5. Examination Lifecycle Constraints
# --------------------------------------------------------------------
WINDOW_DURATION_MINUTES=30
GRACE_PERIOD_MINUTES=2
MAX_UPLOAD_SIZE_MB=7
MAX_PAGE_COUNT=15
REVALUATION_WINDOW_DAYS=7

# --------------------------------------------------------------------
# 6. AI Studio Quota Settings (Used for Feasibility Calculations)
# --------------------------------------------------------------------
USER_RPM_LIMIT=15
USER_TPM_LIMIT=1000000
USER_RPD_LIMIT=1500

# --------------------------------------------------------------------
# 7. Host & Port Configuration
# --------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
DEBUG=false
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# --------------------------------------------------------------------
# 8. Brevo Transactional Email Gateway
# --------------------------------------------------------------------
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
EMAIL_FROM_ADDRESS=noreply@papergradeai.in
EMAIL_FROM_NAME=Papergrade AI
ADMIN_NOTIFICATION_EMAIL=support@papergradeai.in

# --------------------------------------------------------------------
# 9. Google OAuth 2.0 & Drive BYOS (Bring Your Own Storage)
# --------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_REDIRECT_URI=https://api.papergradeai.in/api/oauth/google/callback
GOOGLE_STORAGE_ENCRYPTION_KEY=your-secure-storage-encryption-key
